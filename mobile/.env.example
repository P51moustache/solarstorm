# Supabase (client-safe values; EXPO_PUBLIC_ vars are inlined into the app bundle)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# RevenueCat public iOS SDK key (Project settings -> API keys -> Apple App Store)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxx
