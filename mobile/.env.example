# Copy to .env.local and fill in. The Supabase publishable/anon key is client-safe.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx

# Optional: route data through the Next.js backend instead of NOAA directly.
# EXPO_PUBLIC_API_BASE_URL=https://your-deployed-app.example.com

# RevenueCat public iOS API key (dev/standalone build only — not Expo Go).
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxx
