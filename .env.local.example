# Supabase Configuration (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Stripe Configuration (Required for payments)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-key
NEXT_PUBLIC_STRIPE_PLUS_MONTHLY_PRICE_ID=price_xxx
NEXT_PUBLIC_STRIPE_PLUS_YEARLY_PRICE_ID=price_xxx
NEXT_PUBLIC_STRIPE_PRO_MONTHLY_PRICE_ID=price_xxx
NEXT_PUBLIC_STRIPE_PRO_YEARLY_PRICE_ID=price_xxx

# NASA API Key (Server-side only - NOT exposed to browser)
# Get your API key from https://api.nasa.gov/
NASA_API_KEY=your-nasa-api-key

# OpenWeather API Key (Optional - for weather data)
NEXT_PUBLIC_OPENWEATHER_API_KEY=your-openweather-key

# Development Mode (Optional)
# Set to 'true' to bypass authentication in development
# NEXT_PUBLIC_DEV_BYPASS_AUTH=true
